<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>TempSim.Cli</RootNamespace>
    <AssemblyName>TempSim.Cli</AssemblyName>
    <Version>2.0.1</Version>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\TempSim.Core\TempSim.Core.csproj" />
  </ItemGroup>
  <!-- native libraries + message table next to the executable; RID-specific copies are picked at publish time -->
  <ItemGroup>
    <None Include="..\..\dbc\tables\TempCtl.json" Link="TempCtl.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Import Project="..\NativeAssets.targets" />
</Project>
