<Application x:Class="TempSim.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Startup="OnStartup">
    <Application.Resources>        <Style TargetType="Control"><Setter Property="Foreground" Value="#DCF1FF"/></Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#DCF1FF"/><Setter Property="Background" Value="#193D59"/>
            <Setter Property="BorderBrush" Value="#315A78"/><Setter Property="Padding" Value="10,5"/><Setter Property="Margin" Value="2"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Shell" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="Background" Value="#286080"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="#65E1FF"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Shell" Property="Background" Value="#347C9E"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="TabControl"><Setter Property="Background" Value="#0E2438"/><Setter Property="BorderBrush" Value="#234660"/></Style>
        <Style TargetType="TabItem"><Setter Property="Foreground" Value="#DCF1FF"/><Setter Property="Background" Value="#193D59"/><Setter Property="Padding" Value="10,8"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="Tab" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" BorderThickness="0,0,0,2" BorderBrush="Transparent"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Tab" Property="Background" Value="#234660"/><Setter TargetName="Tab" Property="BorderBrush" Value="#65E1FF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ListView"><Setter Property="Background" Value="#0E2438"/><Setter Property="Foreground" Value="#DCF1FF"/></Style>
        <Style TargetType="ComboBox"><Setter Property="Foreground" Value="#102B43"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
        <Style TargetType="GroupBox"><Setter Property="Foreground" Value="#DCF1FF"/><Setter Property="BorderBrush" Value="#315675"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Padding" Value="4"/>
        </Style>
        <Style TargetType="TextBox"><Setter Property="Foreground" Value="#DCF1FF"/><Setter Property="Background" Value="#102B43"/><Setter Property="BorderBrush" Value="#315675"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="MinWidth" Value="60"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#DCF1FF"/>
            <Setter Property="Margin" Value="2,4"/>
        </Style>
        <Style TargetType="Label"><Setter Property="Foreground" Value="#B7D1E5"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Application.Resources>
</Application>
