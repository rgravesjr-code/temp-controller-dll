<Window x:Class="TempSim.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TempSim.Wpf"
        Title="TempSim - TempCtl v3 + CanTp simulator" Width="1420" Height="940" MinWidth="1000" MinHeight="650"
        Background="#F4F4F4" Closing="OnClosing">
    <DockPanel>
        <!-- toolbar -->
        <Border DockPanel.Dock="Top" Background="#E8E8E8" Padding="6,4" BorderBrush="#CCC" BorderThickness="0,0,0,1">
            <DockPanel>
                <TextBlock x:Name="VersionText" DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="DimGray" Margin="8,0"/>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="RunButton" Content="Pause" Width="70" Margin="0,0,4,0" Click="OnRunPause"/>
                    <Button Content="Reset (TcReset)" Width="110" Margin="0,0,4,0" Click="OnReset" ToolTip="TcReset: clears faults, warnings, averages, accumulators and countdowns; keeps the setup; relays off"/>
                    <Button Content="Restart (TcInit)" Width="100" Margin="0,0,12,0" Click="OnRestart" ToolTip="Fresh plant, TcReset then TcInit with the current setup"/>
                    <Label Content="Speed:"/>
                    <ComboBox x:Name="SpeedCombo" Width="70" SelectedIndex="0" SelectionChanged="OnSpeedChanged">
                        <ComboBoxItem Content="1x"/><ComboBoxItem Content="5x"/><ComboBoxItem Content="20x"/><ComboBoxItem Content="max"/>
                    </ComboBox>
                    <Label Content="Scenario:" Margin="12,0,0,0"/>
                    <ComboBox x:Name="ScenarioCombo" Width="150"/>
                    <Button Content="Load" Width="60" Margin="4,0" Click="OnLoadScenario" ToolTip="Restart with the scenario's settings, timed events and expectations"/>
                    <TextBlock x:Name="EventText" VerticalAlignment="Center" Margin="12,0" Foreground="#A05000" TextTrimming="CharacterEllipsis" MaxWidth="520"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- frames panel -->
        <Border DockPanel.Dock="Bottom" Height="230" Background="White" BorderBrush="#CCC" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <DockPanel Grid.Column="0" Margin="6,2">
                    <TextBlock x:Name="FramesTitle" DockPanel.Dock="Top" Text="NI-XNET raw frames (CanTp_Pack of the TcGetDiag array): J1939 BAM" FontWeight="SemiBold" Margin="0,2"/>
                    <TextBox x:Name="FramesText" FontFamily="Consolas" FontSize="11.5" IsReadOnly="True" BorderThickness="0"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="#FAFAFA"/>
                </DockPanel>
                <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="#DDD"/>
                <DockPanel Grid.Column="2" Margin="6,2">
                    <TextBlock DockPanel.Dock="Top" Text="Decoded on the receive side (CanTp_Unpack of the same records) beside the controller's diagnostics" FontWeight="SemiBold" Margin="0,2"/>
                    <ListView x:Name="DecodedList" FontSize="11.5" BorderThickness="0">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="#" Width="28" DisplayMemberBinding="{Binding Index}"/>
                                <GridViewColumn Header="Diagnostic" Width="150" DisplayMemberBinding="{Binding Name}"/>
                                <GridViewColumn Header="Controller" Width="90" DisplayMemberBinding="{Binding Value}"/>
                                <GridViewColumn Header="Unpacked" Width="90" DisplayMemberBinding="{Binding Unpacked}"/>
                                <GridViewColumn Header="Unit" Width="40" DisplayMemberBinding="{Binding Unit}"/>
                                <GridViewColumn Header="Bits" Width="60" DisplayMemberBinding="{Binding Bits}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </Grid>
        </Border>

        <!-- right: status + settings -->
        <ScrollViewer DockPanel.Dock="Right" Width="400" VerticalScrollBarVisibility="Auto" Background="#F4F4F4">
            <StackPanel Margin="6">
                <GroupBox Header="Controller status (TcCheckTemp outputs + TcGetDiag)">
                    <StackPanel>
                        <TextBlock x:Name="StatusText" FontSize="20" FontWeight="Bold" Margin="2"/>
                        <TextBlock x:Name="WarningText" FontSize="13" Margin="2" TextWrapping="Wrap"/>
                        <TextBlock x:Name="ControlTempText" FontSize="12" Margin="2" TextWrapping="Wrap"/>
                        <Grid Margin="2,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="128"/><ColumnDefinition Width="*"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                            <Label Grid.Row="0" Content="Deadband" ToolTip="DeadbandRemainMs: time before a relay engages"/>
                            <ProgressBar Grid.Row="0" Grid.Column="1" x:Name="DbBar" Height="13" Foreground="#2060C0"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" x:Name="DbText" VerticalAlignment="Center" Margin="6,0"/>
                            <Label Grid.Row="1" Content="At setpoint" ToolTip="AtSetPtRemainMs: time before the running relay drops"/>
                            <ProgressBar Grid.Row="1" Grid.Column="1" x:Name="AspBar" Height="13" Foreground="#20A060"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" x:Name="AspText" VerticalAlignment="Center" Margin="6,0"/>
                            <Label Grid.Row="2" Content="Disagreement" ToolTip="CompareRemainMs: time to the TempDisagreeFault"/>
                            <ProgressBar Grid.Row="2" Grid.Column="1" x:Name="CmpBar" Height="13" Foreground="#D08000"/>
                            <TextBlock Grid.Row="2" Grid.Column="2" x:Name="CmpText" VerticalAlignment="Center" Margin="6,0"/>
                            <Label Grid.Row="3" Content="Heater feedback" ToolTip="HeaterFbRemainMs: time to the HeaterFBFault"/>
                            <ProgressBar Grid.Row="3" Grid.Column="1" x:Name="HfbBar" Height="13" Foreground="#D04000"/>
                            <TextBlock Grid.Row="3" Grid.Column="2" x:Name="HfbText" VerticalAlignment="Center" Margin="6,0"/>
                            <Label Grid.Row="4" Content="Cooler feedback" ToolTip="CoolerFbRemainMs: time to the CoolerFBFault"/>
                            <ProgressBar Grid.Row="4" Grid.Column="1" x:Name="CfbBar" Height="13" Foreground="#D04000"/>
                            <TextBlock Grid.Row="4" Grid.Column="2" x:Name="CfbText" VerticalAlignment="Center" Margin="6,0"/>
                            <Label Grid.Row="5" Content="Sensor 1 out-of-range" ToolTip="Temp1OorAccumMs: leaky accumulator, fails at ErrorTimeout"/>
                            <ProgressBar Grid.Row="5" Grid.Column="1" x:Name="Acc1Bar" Height="13" Foreground="#B00000"/>
                            <TextBlock Grid.Row="5" Grid.Column="2" x:Name="Acc1Text" VerticalAlignment="Center" Margin="6,0"/>
                            <Label Grid.Row="6" Content="Sensor 2 out-of-range" ToolTip="Temp2OorAccumMs: leaky accumulator, fails at ErrorTimeout"/>
                            <ProgressBar Grid.Row="6" Grid.Column="1" x:Name="Acc2Bar" Height="13" Foreground="#B00000"/>
                            <TextBlock Grid.Row="6" Grid.Column="2" x:Name="Acc2Text" VerticalAlignment="Center" Margin="6,0"/>
                        </Grid>
                        <UniformGrid Columns="4" Margin="2">
                            <local:Lamp x:Name="HeatLamp" Caption="doHeater" OnBrush="#E03C1E"/>
                            <local:Lamp x:Name="CoolLamp" Caption="doCooler" OnBrush="#2878F0"/>
                            <local:Lamp x:Name="HeatFbLamp" Caption="Heater DO fb" OnBrush="#E03C1E"/>
                            <local:Lamp x:Name="CoolFbLamp" Caption="Cooler DO fb" OnBrush="#2878F0"/>
                        </UniformGrid>
                        <TextBlock x:Name="SensorText" Margin="2" TextWrapping="Wrap"/>
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="Controller setup (TcInit on every change)">
                    <StackPanel x:Name="ControllerPanel"/>
                </GroupBox>
                <GroupBox Header="Plant">
                    <StackPanel x:Name="PlantPanel"/>
                </GroupBox>
                <GroupBox Header="Sensor 1 (primary)">
                    <StackPanel x:Name="Sensor1Panel"/>
                </GroupBox>
                <GroupBox Header="Sensor 2">
                    <StackPanel x:Name="Sensor2Panel"/>
                </GroupBox>
                <GroupBox Header="Relays (DO feedback)">
                    <StackPanel x:Name="RelayPanel"/>
                </GroupBox>
                <GroupBox Header="Logging">
                    <StackPanel>
                        <CheckBox x:Name="LogCheck" Content="Write CSV + .ncl while running" Checked="OnLogChanged" Unchecked="OnLogChanged"/>
                        <TextBlock x:Name="LogText" Foreground="DimGray" TextWrapping="Wrap" Margin="2"/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <!-- centre: plot -->
        <Border Background="White" BorderBrush="#CCC" BorderThickness="1" Margin="6">
            <local:PlotView x:Name="Plot"/>
        </Border>
    </DockPanel>
</Window>
