<Window x:Class="TempSim.Wpf.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:TempSim.Wpf"
 Title="TempSim · Thermal test bench" Width="1460" Height="960" MinWidth="1100" MinHeight="760"
 Background="#081727" Foreground="#DCF1FF" Closing="OnClosing">
 <DockPanel Margin="16">
  <StackPanel DockPanel.Dock="Top">
   <DockPanel Margin="0,0,0,12">
    <TextBlock DockPanel.Dock="Right" Text="TEMPCTL / CLOSED-LOOP LAB" Foreground="#60CFFF" FontSize="12" VerticalAlignment="Center"/>
    <StackPanel><TextBlock Text="THERMAL TEST BENCH" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="Live temperatures. Physical response. One connected fixture." Foreground="#89A8C3" FontSize="12"/></StackPanel>
   </DockPanel>
   <WrapPanel Margin="0,0,0,12">
    <Button x:Name="RunButton" Content="Pause" Width="72" Click="OnRunPause"/>
    <Button Content="Start" Click="OnStart" ToolTip="TcStart with the live run permissive (refused as IdleStartBlocked when it is false)"/>
    <Button Content="Stop" Click="OnStop" ToolTip="TcStop: both relay commands off at once, no fault"/>
    <CheckBox x:Name="PermissiveCheck" Content="Run permissive" IsChecked="True" VerticalAlignment="Center" Margin="8,0,8,0" Checked="OnPermissiveChanged" Unchecked="OnPermissiveChanged" ToolTip="The host's combined operating-condition input passed to every TcCheckTemp; unchecking it while running de-energizes both relays on the next tick"/>
    <Button Content="Reset fault" Click="OnReset" ToolTip="Stop, apply zero DOs, TcReset, Start again when running"/>
    <Button Content="Restart" Click="OnRestart"/>
    <Label Content="Simulation speed" Margin="10,0,0,0"/>
    <ComboBox x:Name="SpeedCombo" Width="75" SelectedIndex="0" SelectionChanged="OnSpeedChanged"><ComboBoxItem Content="1x"/><ComboBoxItem Content="2x"/><ComboBoxItem Content="3x"/><ComboBoxItem Content="5x"/><ComboBoxItem Content="10x"/><ComboBoxItem Content="20x"/></ComboBox>
    <Button Content="Fixture configuration" Click="OnConfigureFixture" Margin="14,0,4,0"/>
    <Button Content="Run fixture" Click="OnFixtureMode"/><Button x:Name="MotorButton" Content="Stop motors" Click="OnToggleMotors" ToolTip="Drive motors actuate the UUT independently of heating/cooling. Stopping allows them to coast down."/>
    <Label Content="Test scenario" Margin="10,0,0,0"/>
    <ComboBox x:Name="ScenarioCombo" Width="148"/><Button Content="Load" Click="OnLoadScenario"/>
   </WrapPanel>
   <Border Background="#112D46" CornerRadius="8" Padding="15,10" Margin="0,0,0,12"><StackPanel><TextBlock x:Name="LiveReadings" FontFamily="Consolas" FontSize="17" Foreground="#65E1FF"/><TextBlock x:Name="FlowReadings" FontFamily="Consolas" FontSize="14" Foreground="#D7AAEF" Margin="0,7,0,0" TextWrapping="Wrap"/></StackPanel></Border>
  </StackPanel>
  <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
   <TextBlock x:Name="EventText" Foreground="#FFBB76" TextTrimming="CharacterEllipsis"/>
   <TextBlock x:Name="VersionText" Foreground="#89A8C3" FontSize="10"/>
  </StackPanel>
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="365"/></Grid.ColumnDefinitions>
   <Grid Margin="0,0,12,0">
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Background="#0E2438" CornerRadius="10" BorderBrush="#234660" BorderThickness="1" Padding="12" Margin="0,0,0,12">
     <DockPanel><DockPanel DockPanel.Dock="Top" Margin="0,0,0,8"><TextBlock Text="TEMPERATURE HISTORY" FontWeight="SemiBold"/><TextBlock x:Name="ChartUnits" Text="°C · last 120 simulated seconds" HorizontalAlignment="Right" Foreground="#89A8C3"/></DockPanel><local:PlotView x:Name="Plot"/></DockPanel>
    </Border>
    <Border Grid.Row="1" Background="#0E2438" CornerRadius="10" BorderBrush="#234660" BorderThickness="1" Padding="4"><local:FixtureView x:Name="Fixture"/></Border>
   </Grid>
   <TabControl Grid.Column="1" x:Name="DashboardTabs">
    <TabItem Header="Live status"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="8">                <GroupBox Header="Controller status (TcCheckTemp outputs + TcGetDiag, 28 values)">
                    <StackPanel>
                        <TextBlock x:Name="StatusText" FontSize="20" FontWeight="Bold" Margin="2"/>
                        <TextBlock x:Name="WarningText" FontSize="13" Margin="2" TextWrapping="Wrap"/>
                        <TextBlock x:Name="LifecycleText" FontSize="12" Margin="2" TextWrapping="Wrap" Foreground="#9FD8FF"/>
                        <TextBlock x:Name="ControlTempText" FontSize="12" Margin="2" TextWrapping="Wrap"/>
                        <StackPanel>
                            <local:DiagnosticMeter x:Name="DbMeter" Caption="Relay start delay"/>
                            <local:DiagnosticMeter x:Name="AspMeter" Caption="At-setpoint release delay"/>
                            <local:DiagnosticMeter x:Name="CmpMeter" Caption="Sensor disagreement fault delay"/>
                            <local:DiagnosticMeter x:Name="HfbMeter" Caption="Heater feedback fault delay"/>
                            <local:DiagnosticMeter x:Name="CfbMeter" Caption="Cooler feedback fault delay"/>
                            <local:DiagnosticMeter x:Name="OcMeter" Caption="Operating-condition fault delay (permissive lost)"/>
                            <local:DiagnosticMeter x:Name="Acc1Meter" Caption="Sensor 1 invalid-reading accumulation"/>
                            <local:DiagnosticMeter x:Name="Acc2Meter" Caption="Sensor 2 invalid-reading accumulation"/>
                        </StackPanel>
                        <UniformGrid Columns="4" Margin="2">
                            <local:Lamp x:Name="HeatLamp" Caption="doHeater" OnBrush="#E03C1E"/>
                            <local:Lamp x:Name="CoolLamp" Caption="doCooler" OnBrush="#2878F0"/>
                            <local:Lamp x:Name="HeatFbLamp" Caption="Heater DO fb" OnBrush="#E03C1E"/>
                            <local:Lamp x:Name="CoolFbLamp" Caption="Cooler DO fb" OnBrush="#2878F0"/>
                        </UniformGrid>
                        <TextBlock x:Name="SensorText" Margin="2" TextWrapping="Wrap"/>
                    </StackPanel>
                </GroupBox>     </StackPanel></ScrollViewer></TabItem>
    <TabItem Header="Configuration"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="8"><GroupBox Header="Fixture physics · estimated starting values"><StackPanel><TextBlock Text="Edit the thermal model, motors, pump and fan in a dedicated configuration screen." TextWrapping="Wrap" Margin="4"/><Button Content="Configure fixture physics…" Click="OnConfigureFixture" Margin="4"/><Button Content="Run fixture model" Click="OnFixtureMode" Margin="4"/></StackPanel></GroupBox>
                <GroupBox Header="Controller setup (Stop, TcInit, Start on every change)">
                    <StackPanel x:Name="ControllerPanel"/>
                </GroupBox>
                <GroupBox Header="Ambient / legacy plant rates">
                    <StackPanel x:Name="PlantPanel"/>
                </GroupBox>
                <GroupBox Header="Sensor 1 (primary)">
                    <StackPanel x:Name="Sensor1Panel"/>
                </GroupBox>
                <GroupBox Header="Sensor 2">
                    <StackPanel x:Name="Sensor2Panel"/>
                </GroupBox>
                <GroupBox Header="Relays (DO feedback)">
                    <StackPanel x:Name="RelayPanel"/>
                </GroupBox>
                <GroupBox Header="Logging">
                    <StackPanel>
                        <CheckBox x:Name="LogCheck" Content="Write CSV + .ncl while running" Checked="OnLogChanged" Unchecked="OnLogChanged"/>
                        <TextBlock x:Name="LogText" Foreground="#89A8C3" TextWrapping="Wrap" Margin="2"/>
                    </StackPanel>
                </GroupBox>
     </StackPanel></ScrollViewer></TabItem>
    <TabItem Header="CAN data"><Grid>            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="4"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="6,2">
                    <TextBlock x:Name="FramesTitle" DockPanel.Dock="Top" Text="NI-XNET raw frames (CanTp_Pack of the TcGetDiag array): J1939 BAM" FontWeight="SemiBold" Margin="0,2"/>
                    <TextBox x:Name="FramesText" FontFamily="Consolas" FontSize="11.5" IsReadOnly="True" BorderThickness="0"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="#102B43"/>
                </DockPanel>

                <DockPanel Grid.Row="2" Margin="6,2">
                    <TextBlock DockPanel.Dock="Top" Text="Decoded on the receive side (CanTp_Unpack of the same records) beside the controller's diagnostics" FontWeight="SemiBold" Margin="0,2"/>
                    <ListView x:Name="DecodedList" FontSize="11.5" BorderThickness="0">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="#" Width="28" DisplayMemberBinding="{Binding Index}"/>
                                <GridViewColumn Header="Diagnostic" Width="150" DisplayMemberBinding="{Binding Name}"/>
                                <GridViewColumn Header="Controller" Width="90" DisplayMemberBinding="{Binding Value}"/>
                                <GridViewColumn Header="Unpacked" Width="90" DisplayMemberBinding="{Binding Unpacked}"/>
                                <GridViewColumn Header="Unit" Width="40" DisplayMemberBinding="{Binding Unit}"/>
                                <GridViewColumn Header="Bits" Width="60" DisplayMemberBinding="{Binding Bits}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </Grid></Grid></TabItem></TabControl></Grid></DockPanel></Window>
