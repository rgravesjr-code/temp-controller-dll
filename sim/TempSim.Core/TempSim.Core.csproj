<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>TempSim.Core</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="TempSim.RegressionChecks" />
    <!-- Generated from make_tempctl_dbc.py; runtime definitions must match this build's ABI. -->
    <EmbeddedResource Include="..\..\dbc\tables\TempCtl.json" LogicalName="TempSim.TempCtl.json" />
  </ItemGroup>
</Project>
