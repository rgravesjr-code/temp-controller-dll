#include <winver.h>
#include "cantp.h"
#define CT_STR2(x) #x
#define CT_STR(x) CT_STR2(x)
#define CANTP_VERSION_STR CT_STR(CANTP_VERSION_MAJOR) "." CT_STR(CANTP_VERSION_MINOR) "." CT_STR(CANTP_VERSION_PATCH)

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    CANTP_VERSION_MAJOR,CANTP_VERSION_MINOR,CANTP_VERSION_PATCH,0
 PRODUCTVERSION CANTP_VERSION_MAJOR,CANTP_VERSION_MINOR,CANTP_VERSION_PATCH,0
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_DLL
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName",      "Roger Graves"
      VALUE "FileDescription",  "CanTp - generic CAN transport-protocol packer/unpacker (J1939 BAM, CAN FD, DBC scaling)"
      VALUE "FileVersion",      CANTP_VERSION_STR
      VALUE "InternalName",     "cantp"
      VALUE "LegalCopyright",   "Copyright (c) 2026 Roger Graves. MIT License."
      VALUE "OriginalFilename", "cantp.dll"
      VALUE "ProductName",      "cantp"
      VALUE "ProductVersion",   CANTP_VERSION_STR
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
